# File: .env.example
# Purpose: Example environment variables consumed by setup-wsl.sh during provisioning.
# Connection: setup-wsl.sh will source this file (if copied to ".env" in the same directory)
# and use HUGGINGFACE_TOKEN/HF_TOKEN to perform a non-interactive login via huggingface-cli.

# Your Hugging Face access token with at least read permissions
# Copy this file to ".env" and replace the placeholder value below.
# HUGGINGFACE_TOKEN and HF_TOKEN are interchangeable; either works.
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
